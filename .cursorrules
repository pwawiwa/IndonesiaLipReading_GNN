      lips_train.pt
      lips_val.pt
      lips_test.pt
      ...
    B2/
      ...
    B3/
      ...
    B3/         <-- contains AU features only (PCA and motion energy removed for memory optimization)
      lips_train.pt
      lips_val.pt
      lips_test.pt
      mouth_train.pt
      mouth_val.pt
      mouth_test.pt
      full_train.pt
      full_val.pt
